# =========================
# Unity Generated Folders
# =========================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
MemoryCaptures/
Recordings/
# Android/NDK build temp (Gradle + CMake/Ninja intermediates, one tree per build
# hash). 146 files of this were tracked, which is why configure_fingerprint.bin
# showed up as modified after every Android build.
.utmp/

# Unity crash / logs
sysinfo.txt
*.log

# =========================
# IDE / Editor
# =========================
.vs/
.gradle/
.consulo/
ExportedObj/

# Rider / JetBrains
[Aa]ssets/Plugins/Editor/JetBrains*

# =========================
# Visual Studio / Rider files
# =========================
*.csproj
# ...but the headless guards under Tooling/ are hand-written sources, not
# Unity-generated project files. This rule was hiding them from the repo, so CI's
# "dotnet build Tooling/EngineSyntaxCheck" could never work from a fresh clone.
!Tooling/**/*.csproj
*.sln
*.unityproj
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# =========================
# Unity autogenerated meta
# =========================
*.pidb.meta
*.pdb.meta
*.mdb.meta

# =========================
# Builds / exports
# =========================
*.apk
*.aab
*.unitypackage
*.app

# =========================
# Addressables
# =========================
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*

# =========================
# Streaming Assets (optional cleanup)
# =========================
[Aa]ssets/[Ss]treamingAssets/aa*

# =======================
# macOS
# =========================
.DS_Store

UIElementsSchema/

# =========================
# Claude Code (local-only settings)
# =========================
.claude/settings.local.json
# Tooling (headless engine syntax-check) build artifacts
Tooling/**/bin/
Tooling/**/obj/
# Crash dumps / profiler captures / editor screenshots
mono_crash.*.json
ProfilerCaptures/
Assets/Screenshots/
Assets/Screenshots.meta

# Python tooling (Tooling/OfflineDepthBake)
.venv/
__pycache__/
*.pyc
