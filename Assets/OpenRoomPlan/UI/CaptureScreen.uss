/* Designed against the capture scene's dedicated PanelSettings:
   Scale With Screen Size, reference 393x852 (portrait phone), match width.
   Sizes below are therefore "logical points", not device pixels.
   Safe-area padding is applied at runtime by CaptureScreenController. */

.capture-root {
    flex-grow: 1;
    align-items: center;
    justify-content: space-between;
}

.top-panel {
    width: 100%;
    max-width: 480px;
    align-items: center;
}

.title {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.85);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.stats {
    width: 100%;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(0, 0, 0, 0.45);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.stat-line {
    font-size: 14px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.small {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.75);
    margin-top: 4px;
}

.bar {
    width: 100%;
    height: 8px;
    margin-top: 8px;
    background-color: rgba(255, 255, 255, 0.2);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    overflow: hidden;
}

.bar-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(64, 200, 120);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.spacer {
    flex-grow: 1;
}

.bottom-panel {
    width: 100%;
    max-width: 480px;
    align-items: center;
}

.status {
    font-size: 15px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(0, 0, 0, 0.5);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.button-row {
    flex-direction: row;
    width: 100%;
}

.btn {
    flex-grow: 1;
    flex-basis: 0;
    height: 52px;
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-left: 6px;
    margin-right: 6px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.btn-record {
    background-color: rgb(46, 107, 217);
}

.btn-stop {
    background-color: rgb(184, 58, 58);
}

.btn:disabled {
    opacity: 0.4;
}

.btn-export {
    width: 100%;
    flex-grow: 0;
    height: 44px;
    font-size: 15px;
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 8px;
    background-color: rgba(255, 255, 255, 0.16);
}

.hint {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 10px;
}
