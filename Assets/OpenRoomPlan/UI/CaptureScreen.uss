.capture-root {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
}

/* Padding is set at runtime from Screen.safeArea by CaptureScreenController. */

.top-panel {
    align-items: center;
    width: 100%;
}

.title {
    font-size: 30px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 14px;
}

.stats {
    width: 92%;
    align-items: center;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: rgba(0, 0, 0, 0.5);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.stat-line {
    font-size: 24px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.small {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.75);
    margin-top: 8px;
}

.bar {
    width: 100%;
    height: 18px;
    margin-top: 10px;
    background-color: rgba(255, 255, 255, 0.2);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    overflow: hidden;
}

.bar-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(64, 200, 120);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.spacer {
    flex-grow: 1;
}

.status {
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 24px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 20px;
    padding-right: 20px;
    background-color: rgba(0, 0, 0, 0.55);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.button-row {
    flex-direction: row;
}

.btn {
    width: 210px;
    height: 92px;
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-left: 12px;
    margin-right: 12px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

.btn-record {
    background-color: rgb(46, 107, 217);
}

.btn-stop {
    background-color: rgb(184, 58, 58);
}

.btn:disabled {
    opacity: 0.4;
}

.hint {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 18px;
}
