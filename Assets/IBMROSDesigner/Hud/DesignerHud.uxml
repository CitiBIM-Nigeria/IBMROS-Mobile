<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="DesignerHud.uss"/>
    <ui:VisualElement name="DesignerHudRoot" picking-mode="Ignore" class="hud-root">

        <!-- TOP BAR: back, plan name, screenshot, undo/redo (icons are painter-drawn) -->
        <ui:VisualElement name="TopBar" class="bar bar--top">
            <ui:Button name="BackButton" text="✕" class="btn btn--icon"/>
            <ui:Label name="PlanNameLabel" text="Room" class="plan-name"/>
            <ui:VisualElement name="TopBarSpacer" picking-mode="Ignore" class="spacer"/>
            <ui:Button name="ShotButton" class="btn btn--icon"><ui:VisualElement name="ShotIcon" picking-mode="Ignore" class="icon"/></ui:Button>
            <ui:Button name="UndoButton" class="btn btn--icon"><ui:VisualElement name="UndoIcon" picking-mode="Ignore" class="icon"/></ui:Button>
            <ui:Button name="RedoButton" class="btn btn--icon"><ui:VisualElement name="RedoIcon" picking-mode="Ignore" class="icon"/></ui:Button>
        </ui:VisualElement>

        <!-- 2D BROWSE BAR (reference: three labeled actions) -->
        <ui:VisualElement name="BrowseToolbar" class="bar bar--bottom">
            <ui:Button name="BtnOpen3D" class="tool-col">
                <ui:Label text="3D" picking-mode="Ignore" class="tool-col__glyph"/>
                <ui:Label text="Open 3D plan" picking-mode="Ignore" class="tool-col__label"/>
            </ui:Button>
            <ui:Button name="BtnEditWalls" class="tool-col">
                <ui:VisualElement name="EditWallsIcon" picking-mode="Ignore" class="tool-col__icon"/>
                <ui:Label text="Edit Walls" picking-mode="Ignore" class="tool-col__label"/>
            </ui:Button>
            <ui:Button name="BtnAddFurn2D" class="tool-col">
                <ui:VisualElement name="AddIcon2D" picking-mode="Ignore" class="tool-col__icon"/>
                <ui:Label text="Add Furniture" picking-mode="Ignore" class="tool-col__label"/>
            </ui:Button>
        </ui:VisualElement>

        <!-- 2D EDIT-WALLS BAR (reference: Draw Wall · Resize · Add, + Done) -->
        <ui:VisualElement name="EditToolbar" class="bar bar--bottom" style="display: none;">
            <ui:Button name="BtnDone" text="Done" class="btn btn--primary"/>
            <ui:Button name="BtnDrawWall" class="tool-col">
                <ui:VisualElement name="DrawWallIcon" picking-mode="Ignore" class="tool-col__icon"/>
                <ui:Label text="Draw Wall" picking-mode="Ignore" class="tool-col__label"/>
            </ui:Button>
            <ui:Button name="BtnResize" class="tool-col">
                <ui:VisualElement name="ResizeIcon" picking-mode="Ignore" class="tool-col__icon"/>
                <ui:Label text="Resize" picking-mode="Ignore" class="tool-col__label"/>
            </ui:Button>
            <ui:Button name="BtnAddOpening" class="tool-col">
                <ui:VisualElement name="AddOpeningIcon" picking-mode="Ignore" class="tool-col__icon"/>
                <ui:Label text="Add" picking-mode="Ignore" class="tool-col__label"/>
            </ui:Button>
        </ui:VisualElement>

        <!-- ADD sub-menu (door / window), opened by Add in edit mode -->
        <ui:VisualElement name="AddMenu" class="selection-bar" style="display: none;">
            <ui:Button name="BtnAddDoor" text="Door" class="btn"/>
            <ui:Button name="BtnAddWindow" text="Window" class="btn"/>
            <ui:Button name="BtnDrawRect" text="Room" class="btn"/>
        </ui:VisualElement>

        <!-- 3D BAR (reference: 2D · joystick · Add Furniture, all one line) -->
        <ui:VisualElement name="ViewToolbar" class="bar bar--bottom" style="display: none;">
            <ui:Button name="BtnOpen2D" class="tool-col">
                <ui:Label text="2D" picking-mode="Ignore" class="tool-col__glyph"/>
                <ui:Label text="Open 2D plan" picking-mode="Ignore" class="tool-col__label"/>
            </ui:Button>
            <ui:VisualElement name="JoystickSlot" picking-mode="Ignore" class="joystick-slot"/>
            <ui:Button name="BtnAddFurn3D" class="tool-col">
                <ui:VisualElement name="AddIcon3D" picking-mode="Ignore" class="tool-col__icon"/>
                <ui:Label text="Add Furniture" picking-mode="Ignore" class="tool-col__label"/>
            </ui:Button>
        </ui:VisualElement>

        <!-- SELECTION BAR (floating, shown while something is selected in 2D) -->
        <ui:VisualElement name="SelectionBar" class="selection-bar" style="display: none;">
            <ui:Button name="SelDuplicateButton" text="Duplicate" class="btn btn--tool"/>
            <ui:Button name="SelDeleteButton" text="Delete" class="btn btn--danger"/>
        </ui:VisualElement>

        <!-- ROOM SIZE SHEET (bottom card, hidden until Resize) -->
        <ui:VisualElement name="RoomSizeSheet" class="sheet" style="display: none;">
            <ui:Label name="RoomSizeTitle" text="Room size" class="sheet__title"/>
            <ui:TextField name="WidthField" label="Width (m)" class="sheet__field"/>
            <ui:TextField name="LengthField" label="Length (m)" class="sheet__field"/>
            <ui:TextField name="CeilHeightField" label="Ceiling height (m)" class="sheet__field"/>
            <ui:TextField name="WallThickField" label="Wall thickness (m)" class="sheet__field"/>
            <ui:VisualElement name="SheetActions" class="sheet__actions">
                <ui:Button name="SheetApplyButton" text="Apply" class="btn btn--primary sheet__btn"/>
                <ui:Button name="SheetCloseButton" text="Close" class="btn sheet__btn"/>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
