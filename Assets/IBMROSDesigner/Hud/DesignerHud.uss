.hud-root {
    flex-grow: 1;
    justify-content: space-between;
}

/* ---------------------------------------------------------------- bars
   No panels: the scene reads through. Legibility comes from the pill
   behind each control, not from a full-width white strip. */
.bar {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    padding: 10px 14px;
}

.bar--top {
    justify-content: flex-start;
}

.bar--bottom {
    justify-content: space-between;
    padding: 10px 18px 16px 18px;
}

/* ---------------------------------------------------------------- top bar */
.plan-name {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(28, 28, 30);
    margin-left: 10px;
    margin-right: 10px;
}

.spacer {
    flex-grow: 1;
}

/* Circular translucent pill — uniform 44px hit target, evenly spaced. */
.btn--icon {
    width: 44px;
    height: 44px;
    min-width: 44px;
    padding: 0;
    margin: 0 3px;
    border-width: 0;
    border-radius: 22px;
    background-color: rgba(255, 255, 255, 0.72);
    -unity-text-align: middle-center;
    font-size: 19px;
    color: rgb(28, 28, 30);
    align-items: center;
    justify-content: center;
}

.btn--icon:active {
    background-color: rgba(226, 228, 232, 0.95);
}

.btn--icon:disabled {
    opacity: 0.32;
}

.icon {
    width: 22px;
    height: 22px;
}

/* ---------------------------------------------------------------- bottom controls */
.tool-col {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 88px;
    height: 62px;
    padding: 4px 12px;
    margin: 0;
    border-width: 0;
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.72);
}

.tool-col:active {
    background-color: rgba(226, 228, 232, 0.95);
}

.tool-col__glyph {
    font-size: 25px;
    -unity-font-style: bold;
    color: rgb(24, 24, 26);
    -unity-text-align: middle-center;
}

.tool-col__icon {
    width: 26px;
    height: 26px;
}

.tool-col__label {
    margin-top: 1px;
    font-size: 11px;
    color: rgb(78, 78, 84);
    -unity-text-align: middle-center;
}

/* Reserves the joystick's slot so 2D and Add Furniture sit either side of it
   on the same line (the joystick itself is a uGUI canvas underneath). */
.joystick-slot {
    width: 132px;
    height: 62px;
}

/* ---------------------------------------------------------------- edit-mode buttons */
.btn {
    height: 46px;
    min-width: 46px;
    padding: 0 16px;
    margin: 0 4px;
    border-radius: 14px;
    border-width: 0;
    background-color: rgba(255, 255, 255, 0.72);
    color: rgb(28, 28, 30);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.btn:active {
    background-color: rgba(226, 228, 232, 0.95);
}

.btn--primary {
    background-color: rgb(28, 28, 30);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    min-width: 72px;
}

.btn--primary:active {
    background-color: rgb(72, 72, 78);
}

.btn--armed {
    background-color: rgb(70, 130, 220);
    color: rgb(255, 255, 255);
}

.btn--danger {
    background-color: rgb(214, 69, 65);
    color: rgb(255, 255, 255);
}

.btn--danger:active {
    background-color: rgb(170, 50, 47);
}

.btn:disabled {
    opacity: 0.35;
}

/* ------------------------------------------------------- dark-scene variant
   Panels are gone, so the controls themselves carry the contrast. Over a lit
   3D room a white pill disappears; these swap to a dark scrim with light text
   so the toolbar stays readable without reintroducing a full-width panel. */
.hud--dark .btn--icon,
.hud--dark .tool-col,
.hud--dark .btn {
    background-color: rgba(22, 22, 26, 0.55);
    color: rgb(248, 248, 250);
}

.hud--dark .btn--icon:active,
.hud--dark .tool-col:active,
.hud--dark .btn:active {
    background-color: rgba(60, 60, 68, 0.85);
}

.hud--dark .plan-name,
.hud--dark .tool-col__glyph {
    color: rgb(250, 250, 252);
}

.hud--dark .tool-col__label {
    color: rgba(240, 240, 245, 0.85);
}

.hud--dark .btn--primary {
    background-color: rgb(248, 248, 250);
    color: rgb(20, 20, 24);
}

/* ---------------------------------------------------------------- selection + sheet */
.selection-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 96px;
    flex-direction: row;
    justify-content: center;
}

/* -------------------------------------------------------------------- hint
   Transient one-line guidance / rejection feedback (currently the split tool).
   Sits just above the bottom bar so it never covers the plan the user is aiming
   at, and never takes input — a hint that swallows the next tap is worse than no
   hint. Sized inline in the controller only where structure demands it; the look
   lives here. */
.hint {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 104px;
    padding: 9px 14px;
    background-color: rgba(20, 20, 22, 0.86);
    border-radius: 12px;
    color: rgb(248, 248, 250);
    font-size: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.sheet {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 96px;
    background-color: rgb(255, 255, 255);
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.08);
    padding: 16px;
}

.sheet__title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(25, 25, 25);
    margin-bottom: 10px;
}

.sheet__field {
    margin-bottom: 8px;
}

.sheet__field .unity-base-field__label {
    min-width: 150px;
    font-size: 14px;
    color: rgb(60, 60, 60);
}

.sheet__field .unity-base-text-field__input {
    height: 40px;
    border-radius: 8px;
    font-size: 15px;
    padding: 0 10px;
}

.sheet__actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 6px;
}

.sheet__btn {
    min-width: 96px;
}
