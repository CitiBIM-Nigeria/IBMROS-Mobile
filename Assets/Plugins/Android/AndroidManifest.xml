<?xml version="1.0" encoding="utf-8"?>
<!--
  Android App Links intent-filter for QR deep links:  https://<domain>/p/<id>

  PLACEHOLDER domain: replace "placeholder.ibmros.local" with the production host
  (must match link_config.json AND Assets/MyStuffs/Scripts/Managers/LinkConfig.cs),
  then deploy /.well-known/assetlinks.json on that domain containing THIS app's
  RELEASE signing SHA-256 so android:autoVerify succeeds.

  ACTIVITY NAME: this project builds with GameActivity (ProjectSettings
  androidApplicationEntry: 2), so the entry activity is
  com.unity3d.player.UnityPlayerGameActivity. If you switch back to the classic
  Activity, change it to com.unity3d.player.UnityPlayerActivity.

  WHAT UNITY MERGES, AND WHAT IT DOES NOT. Unity uses this file as the BASE for
  unityLibrary/src/main/AndroidManifest.xml and decorates the activity node with the
  attributes and meta-data it needs (configChanges, launchMode, theme,
  screenOrientation, WindowManagerPreference, <layout>...). It does NOT contribute
  intent-filters: the ones declared here are the complete set for this activity.

  So the MAIN/LAUNCHER filter below is REQUIRED and must stay first. Without it the
  APK builds and installs, but has no entry point — no launcher icon, and
  "Build And Run" fails with "No activity in the manifest with action MAIN and
  category LAUNCHER". An earlier revision of this file declared only the two VIEW
  filters and produced exactly that.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

  <!-- QR scanning needs the camera. Declared explicitly rather than inherited: until now
       the permission only reached the merged manifest because the ARCore package
       contributes it, so scanning silently depended on the AR loader staying enabled for
       Android. The runtime grant is requested in QrScannerController. -->
  <uses-permission android:name="android.permission.CAMERA" />

  <application>
    <activity
        android:name="com.unity3d.player.UnityPlayerGameActivity"
        android:exported="true"
        tools:node="merge">

      <!-- THE ENTRY POINT. Declaring any intent-filter on this activity makes this file
           the sole source of its filters, so the launcher one has to be stated here too.
           This is the exact filter Unity generated by itself before a custom manifest
           existed (verified against the last working build). -->
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>

      <!-- Universal/App Link: opens the app for https://<domain>/p/*  -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data
            android:scheme="https"
            android:host="placeholder.ibmros.local"
            android:pathPrefix="/p/" />
      </intent-filter>

      <!-- Optional custom scheme for in-app / testing: ibmros://p/<id>  -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="ibmros" android:host="p" />
      </intent-filter>

    </activity>

    <!-- Lets the OpenRoomPlan export hand a session zip to the system share sheet.
         ACTION_SEND needs a content:// URI — a file:// path throws
         FileUriExposedException on API 24+ — and this provider mints one for the
         exports folder only.

         The <paths> resource it points at lives in the Android Library Project
         OpenRoomPlanShare.androidlib/res/xml/orp_file_paths.xml, NOT in
         Assets/Plugins/Android/res: Unity 6 removed that folder and fails the build
         with "OBSOLETE - Providing Android resources in Assets/Plugins/Android/res
         was removed". Keep the resource in the .androidlib.

         Used as the FALLBACK: the exporter's MediaStore insert already returns a
         shareable URI when it succeeds, and that needs no provider at all. This
         covers the ROMs where MediaStore refuses.

         Authority must match SessionShare.FileProviderSuffix. exported=false plus
         grantUriPermissions=true is the required pair: nobody may query the provider,
         but the one URI attached to a share Intent is readable by its recipient. -->
    <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.orpfileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
      <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/orp_file_paths" />
    </provider>

  </application>
</manifest>
