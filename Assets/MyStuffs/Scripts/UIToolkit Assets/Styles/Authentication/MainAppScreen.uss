@import url("project://database/Assets/MyStuffs/IbmRos/Scripts/UI/Styles/IbmRosTheme.uss?fileID=7433441132597879392&guid=934fe7e1c0c5c4bf4a36002625785e6f&type=3#IbmRosTheme");

/* ============================================
   MAIN APP SCREEN  —  v2
   Simplified layout:
     • No AR banner
     • No furniture catalog / category chips
     • My Rooms — Add Room button only for now
     • 3-item bottom nav (Home, Rooms, Profile)
     • Theme toggle + accent picker in profile panel
============================================ */


/* ============================================
   ROOT & SCROLL
============================================ */

.main-app-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--color-bg-primary);
}

.main-scroll {
    flex-grow: 1;
    width: 100%;
}

.main-scroll > .unity-scroll-view__content-and-vertical-scroll-container {
    flex-grow: 1;
}

.main-scroll > .unity-scroll-view__content-and-vertical-scroll-container
> .unity-scroll-view__content-container {
    padding: 0;
}

.main-content {
    flex-direction: column;
    width: 100%;
    padding-bottom: var(--space-4);
}


/* ============================================
   TOP HEADER
============================================ */

.main-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--safe-area-top);
    padding-left: var(--space-5);
    padding-right: var(--space-5);
    padding-bottom: var(--space-4);
    background-color: var(--color-bg-surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border-subtle);
    flex-shrink: 0;
}

.main-header__left {
    flex-direction: row;
    align-items: center;
}

.main-header__logo {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background-color: var(--color-brand-secondary);
    align-items: center;
    justify-content: center;
    margin-right: var(--space-3);
    flex-shrink: 0;
}

.main-header__logo-text {
    font-size: var(--font-size-sm);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.main-header__greeting-col {
    flex-direction: column;
}

.main-header__greeting {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
}

.main-header__username {
    font-size: var(--font-size-md);
    color: var(--color-text-primary);
    -unity-font-style: bold;
    margin-top: 1px;
}

.main-header__right {
    flex-direction: row;
    align-items: center;
}

/* Notification / theme-toggle icon buttons */
.main-header__icon-btn {
    width: 40px;
    height: 40px;
    background-color: var(--color-bg-elevated);
    border-radius: var(--radius-full);
    border-width: 1px;
    border-color: var(--color-border-subtle);
    align-items: center;
    justify-content: center;
    margin-right: var(--space-2);
    padding: 0;
}

.main-header__icon-btn:hover {
    background-color: var(--color-bg-input);
    border-color: var(--color-border-active);
}

.main-header__icon-label {
    font-size: 18px;
    -unity-text-align: middle-center;
    color: var(--color-text-secondary);
}

.main-header__profile-btn {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    width: auto;
    height: auto;
}

.main-header__profile-btn:hover .avatar {
    border-width: 2px;
    border-color: var(--color-brand-secondary);
}


/* ============================================
   SECTION SHARED
============================================ */

.main-section {
    flex-direction: column;
    width: 100%;
}

.main-section__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: var(--space-5);
    padding-right: var(--space-5);
    margin-bottom: var(--space-3);
}

.main-section__see-all {
    height: auto;
    padding: 0;
    width: auto;
}

.main-section__see-all Label {
    font-size: var(--font-size-sm);
    color: var(--color-brand-secondary);
}


/* ============================================
   MY ROOMS
============================================ */

.main-rooms-scroll {
    width: 100%;
}

.main-rooms-scroll > .unity-scroll-view__content-and-vertical-scroll-container
> .unity-scroll-view__content-container {
    flex-direction: row;
    padding-left: var(--space-5);
    padding-right: var(--space-5);
    padding-bottom: var(--space-2);
}

.main-rooms-row {
    flex-direction: row;
    align-items: flex-start;
}

/* Base room card */
.main-room-card {
    width: 130px;
    background-color: var(--color-bg-surface);
    border-radius: var(--radius-xl);
    border-width: 1px;
    border-color: var(--color-border-subtle);
    overflow: hidden;
    margin-right: var(--space-3);
    flex-shrink: 0;
    padding: 0;
}

.main-room-card:hover {
    border-color: var(--color-border-active);
}

.main-room-card:active {
    scale: 0.97;
}

/* Add new room card */
.main-room-card--add {
    align-items: center;
    justify-content: center;
    height: 150px;
    background-color: transparent;
    border-style: dashed;
    border-color: var(--color-border-default);
    flex-direction: column;
}

.main-room-card--add:hover {
    border-color: var(--color-brand-secondary);
    background-color: rgba(10, 132, 255, 0.04);
}

.main-room-card__add-icon {
    font-size: var(--font-size-3xl);
    color: var(--color-text-placeholder);
    -unity-text-align: middle-center;
    margin-bottom: var(--space-2);
}

.main-room-card--add:hover .main-room-card__add-icon {
    color: var(--color-brand-secondary);
}

.main-room-card__add-text {
    font-size: var(--font-size-sm);
    color: var(--color-text-placeholder);
    -unity-text-align: middle-center;
}

.main-room-card--add:hover .main-room-card__add-text {
    color: var(--color-brand-secondary);
}

/* Room card image area — drop a background-image here from C# */
.main-room-card__image {
    width: 100%;
    height: 100px;
    background-color: var(--color-bg-elevated);
    align-items: center;
    justify-content: center;
    /* IMAGE SLOT: set background-image from C# via:
       card.Q<VisualElement>("RoomCardImage").style.backgroundImage = ... */
}

.main-room-card__placeholder-icon {
    font-size: 40px;
    -unity-text-align: middle-center;
    opacity: 0.5;
}

.main-room-card__footer {
    flex-direction: column;
    padding: var(--space-3);
    background-color: var(--color-bg-surface);
}

.main-room-card__name {
    font-size: var(--font-size-sm);
    color: var(--color-text-primary);
    -unity-font-style: bold;
}

.main-room-card__count {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    margin-top: 2px;
}

/* Empty-state hint shown when there are no saved rooms yet */
.main-rooms-empty {
    padding-left: var(--space-5);
    padding-right: var(--space-5);
    padding-top: var(--space-2);
    padding-bottom: var(--space-4);
}

.main-rooms-empty__text {
    font-size: var(--font-size-sm);
    color: var(--color-text-placeholder);
    white-space: normal;
}


/* ============================================
   BOTTOM NAVIGATION  —  3 items
============================================ */

.main-bottom-nav {
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    background-color: var(--color-bg-surface);
    border-top-width: 1px;
    border-top-color: var(--color-border-subtle);
    padding-bottom: var(--safe-area-bottom);
    padding-top: var(--space-2);
    flex-shrink: 0;
    height: 70px;
}

.main-nav-item {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0;
    padding: var(--space-2);
    width: auto;
    flex-grow: 1;
    height: 100%;
}

.main-nav-item__icon {
    font-size: 22px;
    -unity-text-align: middle-center;
    color: var(--color-text-placeholder);
}

.main-nav-item__label {
    font-size: var(--font-size-xs);
    color: var(--color-text-placeholder);
    -unity-text-align: middle-center;
    margin-top: 3px;
    letter-spacing: var(--letter-spacing-wide);
}

.main-nav-item--active .main-nav-item__icon {
    color: var(--color-brand-secondary);
}

.main-nav-item--active .main-nav-item__label {
    color: var(--color-brand-secondary);
    -unity-font-style: bold;
}

.main-nav-item:hover .main-nav-item__icon {
    color: var(--color-text-secondary);
}

/* Bottom padding so scroll content clears the nav bar */
.main-bottom-pad {
    height: 80px;
}


/* ============================================
   PROFILE PANEL  +  BACKDROP
============================================ */

.main-profile-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-bg-overlay);
    display: none;
}

.main-profile-backdrop--visible {
    display: flex;
}

.main-profile-panel {
    position: absolute;
    top: 80px;
    right: var(--space-5);
    width: 280px;
    background-color: var(--color-bg-surface);
    border-radius: var(--radius-xl);
    border-width: 1px;
    border-color: var(--color-border-subtle);
    padding: var(--space-4);
    display: none;
}

.main-profile-panel--visible {
    display: flex;
    flex-direction: column;
}

/* User info header */
.main-profile-panel__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-4);
}

.main-profile-panel__info {
    flex-direction: column;
    margin-left: var(--space-3);
    flex-grow: 1;
}

.main-profile-panel__name {
    font-size: var(--font-size-md);
    color: var(--color-text-primary);
    -unity-font-style: bold;
}

.main-profile-panel__email {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin-top: 2px;
}

/* Menu items */
.main-profile-panel__item {
    flex-direction: row;
    align-items: center;
    background-color: transparent;
    border-width: 0;
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    border-radius: var(--radius-md);
    width: 100%;
}

.main-profile-panel__item:hover {
    background-color: var(--color-bg-elevated);
}

.main-profile-panel__item-icon {
    font-size: var(--font-size-lg);
    width: 24px;
    -unity-text-align: middle-center;
    color: var(--color-text-secondary);
    margin-right: var(--space-3);
}

.main-profile-panel__item-label {
    font-size: var(--font-size-md);
    color: var(--color-text-primary);
    flex-grow: 1;
    -unity-text-align: middle-left;
}

/* Danger items */
.main-profile-panel__item--danger:hover {
    background-color: var(--color-error-light);
}

.main-profile-panel__item-label--danger {
    font-size: var(--font-size-md);
    color: var(--color-error);
    flex-grow: 1;
    -unity-text-align: middle-left;
}


/* ============================================
   THEME TOGGLE ROW  (inside profile panel)
============================================ */

.theme-toggle-row {
    flex-direction: row;
    align-items: center;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    margin-bottom: var(--space-1);
}

.theme-toggle-row__label {
    font-size: var(--font-size-md);
    color: var(--color-text-primary);
    flex-grow: 1;
    -unity-text-align: middle-left;
}

/* The pill toggle track */
.theme-toggle-track {
    width: 46px;
    height: 26px;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-elevated);
    border-width: 1.5px;
    border-color: var(--color-border-default);
    align-items: center;
    justify-content: flex-start;
    padding-left: 2px;
    padding-right: 2px;
    cursor: link;
    flex-shrink: 0;
    flex-direction: row;
}

.theme-toggle-track--on {
    background-color: var(--color-brand-secondary);
    border-color: var(--color-brand-secondary);
    justify-content: flex-end;
}

/* The thumb inside the track */
.theme-toggle-thumb {
    width: 20px;
    height: 20px;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-surface);
    flex-shrink: 0;
}

.theme-toggle-track--on .theme-toggle-thumb {
    background-color: rgb(255, 255, 255);
}

/* Icon inside thumb */
.theme-toggle-icon {
    font-size: 11px;
    -unity-text-align: middle-center;
    color: var(--color-text-placeholder);
}


/* ============================================
   ACCENT COLOUR PICKER  (inside profile panel)
============================================ */

.accent-picker-row {
    flex-direction: column;
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    padding-bottom: var(--space-3);
}

.accent-picker-label {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    letter-spacing: var(--letter-spacing-wider);
    -unity-font-style: bold;
    margin-bottom: var(--space-2);
}

.accent-picker-dots {
    flex-direction: row;
    align-items: center;
}

/* Individual colour dot */
.accent-dot {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    margin-right: var(--space-2);
    border-width: 2px;
    border-color: transparent;
    align-items: center;
    justify-content: center;
    cursor: link;
    flex-shrink: 0;
}

.accent-dot:hover {
    scale: 1.1;
}

.accent-dot--selected {
    border-color: var(--color-text-primary);
}

.accent-dot__check {
    font-size: 12px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    display: none;
}

.accent-dot--selected .accent-dot__check {
    display: flex;
}

/* The five preset dot colours — backgrounds are hardcoded
   because they represent fixed palette choices */
.accent-dot--blue   { background-color: rgb(10, 132, 255); }
.accent-dot--green  { background-color: rgb(16, 185, 129); }
.accent-dot--purple { background-color: rgb(139, 92, 246); }
.accent-dot--amber  { background-color: rgb(245, 158, 11); }
.accent-dot--rose   { background-color: rgb(244, 63, 94);  }
